pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = "mohith4648"
        // ENTER YOUR REAL DOCKER HUB PASSWORD HERE
        DOCKER_HUB_PASS = "dckr_pat__8huaWVfjTtjjc4g622LRU0Nvp0" 
        
        IMAGE_NAME = "intern-project"
        TAG = "v1"
    }

    stages {
        stage('1. Setup & Pull') {
            steps {
                cleanWs()
                git branch: 'main', url: 'https://github.com/Mohith4648/internfile.git'
            }
        }

        stage('2. Docker Build') {
            steps {
                dir('UI') {
                    // This builds your UI image from the Dockerfile
                    sh "docker build -t ${env.DOCKER_HUB_USER}/${env.IMAGE_NAME}:${env.TAG} ."
                }
            }
        }

        stage('3. Selenium Verification') {
            steps {
                // 1. Run the app container temporarily for testing
                sh "docker run -d --name test-con -p 8085:80 ${env.DOCKER_HUB_USER}/${env.IMAGE_NAME}:${env.TAG}"
                
                script {
                    try {
                        // 2. Run tests inside a specialized Python container
                        // -v mounts your code into the container
                        // --network host allows it to see the app on port 8085
                        sh """
                            docker run --rm \
                            --network host \
                            -v ${WORKSPACE}/UI/tests:/apps \
                            -w /apps \
                            python:3.9-slim /bin/sh -c "pip install selenium && python selenium_check.py"
                        """
                        echo "SELENIUM TESTS PASSED SUCCESSFULLY"
                    } catch (Exception e) {
                        echo "SELENIUM TESTS FAILED: ${e.getMessage()}"
                        // If you want the build to stop on failure, uncomment the line below:
                        // error "Stopping build due to test failure"
                    } finally {
                        // 3. Always remove the test container
                        sh "docker rm -f test-con || true"
                    }
                }
            }
        }

        stage('4. Push to Docker Hub') {
            steps {
                sh """
                    echo "${env.DOCKER_HUB_PASS}" | docker login -u "${env.DOCKER_HUB_USER}" --password-stdin
                    docker push ${env.DOCKER_HUB_USER}/${env.IMAGE_NAME}:${env.TAG}
                    docker logout
                """
            }
        }

        stage('5. Production Deployment') {
            steps {
                // Remove any old production container and start the new one
                sh "docker rm -f prod-site || true"
                sh "docker run -d --name prod-site -p 8081:80 ${env.DOCKER_HUB_USER}/${env.IMAGE_NAME}:${env.TAG}"
                
                echo "----------------------------------------------------"
                echo "SUCCESS: App is live at: http://localhost:8081"
                echo "----------------------------------------------------"
            }
        }
    }
}
