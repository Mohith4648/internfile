pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = "mohith4648"
        DOCKER_HUB_PASS = "dckr_pat__8huaWVfjTtjjc4g622LRU0Nvp0"

        IMAGE_NAME = "intern-project"
        TAG = "v1"
    }

    stages {

        stage('1. Cleanup & Checkout') {
            steps {
                cleanWs()
                git branch: 'main', url: 'https://github.com/Mohith4648/internfile.git'
            }
        }

        stage('2. Build App Docker Image') {
            steps {
                dir('UI') {
                    sh "docker build -t ${DOCKER_HUB_USER}/${IMAGE_NAME}:${TAG} ."
                }
            }
        }

        stage('3. Build Selenium Image') {
            steps {
                echo "Building Selenium Image..."
                sh "docker build -t my-selenium:latest -f UI/tests/Dockerfile.selenium UI/tests"
            }
        }

        stage('4. Start Test Environment') {
            steps {
                script {
                    sh "docker rm -f test-con || true"

                    sh """
                    docker run -d \
                    --name test-con \
                    -p 8085:80 \
                    ${DOCKER_HUB_USER}/${IMAGE_NAME}:${TAG}
                    """

                    // Wait until app is ready
                    sh """
                    until curl -s http://127.0.0.1:8085 > /dev/null; do
                      echo "Waiting for app to start..."
                      sleep 2
                    done
                    """
                }
            }
        }

        stage('5. Selenium Quality Gate') {
            steps {
                script {
                    try {
                        echo "Running Selenium Tests..."

                        sh """
                        docker run --rm \
                        --network host \
                        -v ${WORKSPACE}/UI/tests:/apps \
                        -w /apps \
                        my-selenium:latest \
                        python selenium_check.py
                        """

                        echo "SELENIUM TEST PASSED ✅"

                    } catch (Exception e) {
                        echo "SELENIUM TEST FAILED ❌"
                        error "Stopping pipeline due to test failure."
                    }
                }
            }
        }

        stage('6. Cleanup Test Environment') {
            steps {
                sh "docker rm -f test-con || true"
            }
        }

        stage('7. Push to Docker Hub') {
            steps {
                sh """
                echo "${DOCKER_HUB_PASS}" | docker login -u "${DOCKER_HUB_USER}" --password-stdin
                docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:${TAG}
                docker logout
                """
            }
        }

        stage('8. Production Deployment') {
            steps {
                sh "docker rm -f prod-site || true"

                sh """
                docker run -d \
                --name prod-site \
                -p 8081:80 \
                ${DOCKER_HUB_USER}/${IMAGE_NAME}:${TAG}
                """

                echo "--------------------------------------------"
                echo " ✅ PROJECT DEPLOYED SUCCESSFULLY"
                echo " 🌐 URL: http://localhost:8081"
                echo "--------------------------------------------"
            }
        }
    }

    post {
        always {
            echo "Pipeline Finished."
        }

        success {
            echo "🎉 BUILD & DEPLOYMENT SUCCESSFUL"
        }

        failure {
            echo "🔥 BUILD FAILED - CHECK LOGS"
        }
    }
}
